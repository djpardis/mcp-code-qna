#!/usr/bin/env bash
# Thin wrapper around the local-first Python entry points.
#
#   ./mcp serve [REPO_PATH] [--port PORT] [--host HOST] [--rebuild]
#   ./mcp ask   REPO_PATH "your question"
set -euo pipefail

show_help() {
  cat <<'EOF'
mcp - simple wrapper around the local-first code evidence tools

Usage:
  mcp serve [repo_path] [--port PORT] [--host HOST] [--rebuild]
  mcp ask   repo_path "question"

Options:
  --port PORT     Server port (default: 8000)
  --host HOST     Bind host  (default: 0.0.0.0)
  --rebuild       Force rebuild of the index
  -h, --help      Show this help

Examples:
  mcp serve ./my-repo --port 8001
  mcp ask   ./my-repo "What does class UserService do?"
EOF
}

if [[ $# -eq 0 || "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  show_help
  exit 0
fi

command=$1; shift

case "$command" in
  serve)
    repo_path=""
    if [[ $# -gt 0 && "$1" != --* ]]; then
      repo_path=$1; shift
    fi
    args=()
    if [[ -n "$repo_path" ]]; then
      args+=(--repo-path "$repo_path")
    fi
    args+=("$@")
    exec python3 -m app.mcp_web_server "${args[@]}"
    ;;
  ask)
    if [[ $# -lt 2 ]]; then
      echo "Error: 'ask' requires a repo path and a question" >&2
      show_help
      exit 1
    fi
    repo_path=$1; shift
    question=$1; shift
    exec python3 -m app.cli --repo-path "$repo_path" "$question" "$@"
    ;;
  *)
    echo "Unknown command: $command" >&2
    show_help
    exit 1
    ;;
esac
